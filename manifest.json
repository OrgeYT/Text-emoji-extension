{
  "manifest_version": 3,
  "name": "Text Emoji",
  "version": "1.3.0",
  "description": "Right-click in any text field to insert cute text emojis from a dark-themed menu.",
  "permissions": [
    "contextMenus",
    "activeTab",
    "scripting"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["textemojis.js", "content.js"],
      "css": ["menu.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Text Emoji",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
